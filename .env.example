# Copy to .env.local and fill in to run the AI tutor locally.
# Get a key at https://aistudio.google.com/apikey (free tier).
# In production this is set in the Vercel project settings instead.
GEMINI_API_KEY=

# Optional: override the model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-3.6-flash
