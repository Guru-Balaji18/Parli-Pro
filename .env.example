# Copy to .env.local to run the AI tutor locally.
# In production these are set in the Vercel project instead.

# Main provider: free, no credit card, ~1,000 requests a day.
# Key from https://console.groq.com/keys
GROQ_API_KEY=

# Fallback, used only when Groq is rate-limited. Its free tier is ~20/day.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional extra fallback: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
